# ── Backend ─────────────────────────────────────────────────────
APP_SECRET=               # Texto aleatorio de 32+ caracteres (firma las sesiones). Ej: openssl rand -hex 32

# ── Base de datos ──────────────────────────────────────────────
DATABASE_URL=             # mysql://usuario:clave@host:3306/base

# ── Login con Google ───────────────────────────────────────────
# Consola: https://console.cloud.google.com/apis/credentials → "ID de cliente de OAuth" (Aplicación web)
# URI de redirección autorizada (exacta):  <APP_URL>/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000   # En producción: https://tu-dominio.com (sin "/" final)

# ── Administrador ──────────────────────────────────────────────
OWNER_EMAIL=              # Quien entre con este correo (verificado por Google) será admin

# ── Solo desarrollo ────────────────────────────────────────────
DEV_LOGIN=false           # true => habilita /api/dev-login (login falso). Ignorado en producción.

# ── Almacenamiento de imágenes (AWS S3 o Cloudflare R2) ──────────
# Si no se configura, la carga de imágenes en el panel de comercio requiere configurar estas variables.
S3_BUCKET=
S3_REGION=auto
# Para Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Para AWS S3, normalmente dejar vacío.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL pública de lectura del bucket/CDN, sin slash final (ej. https://imagenes.tudominio.com)
S3_PUBLIC_URL=

# ── Firebase Cloud Messaging (notificaciones push) ─────────────
# Backend: pega el JSON completo de la cuenta de servicio como una sola línea.
# Nunca uses este valor en variables VITE_ ni lo publiques en el frontend.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Frontend: Firebase Console → configuración del proyecto → tu app web.
# Son datos de configuración públicos; la clave privada va SOLO en FIREBASE_SERVICE_ACCOUNT_JSON.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Firebase Console → Configuración del proyecto → Cloud Messaging → certificado Web Push (VAPID)
VITE_FIREBASE_VAPID_KEY=

# Email transaccional para verificación y recuperación (Resend)
RESEND_API_KEY=
AUTH_EMAIL_FROM=Al Rescate <noreply@tu-dominio.com>

# ── Proxy / IP del cliente ─────────────────────────────────────
# Cuántos proxies de confianza hay delante de la app (0 = conexiones directas, 1 = un proxy como Render/Railway/Nginx).
# Define de dónde se lee la IP real para los límites de intentos. Por defecto: 1 en producción, 0 en local.
# Importante: el servidor solo debe aceptar tráfico que pase por ese proxy.
TRUSTED_PROXY_HOPS=
# Si tu app está detrás de varios proxies (p. ej. Vercel que reenvía a Railway) el valor puede ser 2 o más.
# Un valor incorrecto hace que TODOS los usuarios compartan el mismo límite de intentos.
# Para comprobarlo: pon DEBUG_CLIENT_IP=true, abre /login desde tu casa y mira el log del servidor:
# la "IP detectada" debe ser LA TUYA (la que muestra https://ifconfig.me). Si no, sube o baja TRUSTED_PROXY_HOPS.
DEBUG_CLIENT_IP=
